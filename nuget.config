<?xml version="1.0" encoding="utf-8"?>
<!-- This line builds against Boogie 3.5.5 with the fix for boogie-org/boogie#1168, from the
     release v3.5.5+review.37e4435d of the fork https://github.com/erniecohen/boogie (its
     REVIEW.md says what it changes).  Scripts/fetch-boogie-packages.sh downloads the packages
     into Binaries/boogie-packages and checks each against Scripts/boogie-packages.sha256; run
     it once before the first build.  Every Boogie package comes from that folder and nowhere
     else, so a missing package stops the restore instead of falling back to nuget.org's 3.5.5.
     Every other package comes from nuget.org, as without this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="boogie-review" value="Binaries/boogie-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="boogie-review">
      <package pattern="Boogie" />
      <package pattern="Boogie.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
