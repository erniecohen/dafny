; A four-stage proof of inconsistency in iset-erased-core.smt2.
; Each stage checks the negation of an implication used by the proof.
; Expected: four occurrences of unsat. No claim about default Boogie scheduling.
(set-option :timeout 10000)
(declare-sort U 0)
(declare-fun dec (U) Bool)
(declare-fun sel (U U) U)
(declare-fun upd (U U U) U)
(declare-const m U)
(declare-const k U)
(declare-const u U)
(declare-const v U)
(declare-const y U)
(assert (forall ((m U) (x U) (v U)) (= (sel (upd m x v) x) v)))
(assert (forall ((m U) (x U) (y U) (v U))
  (=> (distinct x y) (= (sel (upd m x v) y) (sel m y)))))
; 1. Equal decoded contents give equal decoded reads at an arbitrary index.
(push)
(assert (= (dec u) (dec v)))
(assert (not (= (dec (sel (upd m k u) y)) (dec (sel (upd m k v) y)))))
(check-sat)
(pop)
; 2. Universal closure of stage 1 plus source extensionality equates the maps.
(push)
(assert (forall ((a U) (b U))
  (=> (forall ((x U)) (= (dec (sel a x)) (dec (sel b x)))) (= a b))))
(assert (forall ((x U))
  (= (dec (sel (upd m k u) x)) (dec (sel (upd m k v) x)))))
(assert (distinct (upd m k u) (upd m k v)))
(check-sat)
(pop)
; 3. Equal stores force their raw stored values equal.
(push)
(assert (= (upd m k u) (upd m k v)))
(assert (distinct u v))
(check-sat)
(pop)
; 4. Stages 1-3 prove dec injective. Three distinct U values contradict it.
(push)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(assert (distinct a b c))
(assert (forall ((x U) (z U)) (=> (= (dec x) (dec z)) (= x z))))
(check-sat)
(pop)
