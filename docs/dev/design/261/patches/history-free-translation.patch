diff --git a/Source/DafnyCore/Verifier/TranslationLocalState.cs b/Source/DafnyCore/Verifier/TranslationLocalState.cs
new file mode 100644
--- /dev/null
+++ b/Source/DafnyCore/Verifier/TranslationLocalState.cs
@@ -0,0 +1,89 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace Microsoft.Dafny;
+
+/// <summary>
+/// Proposal seam for the checked immutable resolution manifest. This is supplied
+/// by the cache driver only after its closure/options/provenance are validated.
+/// Collections are snapshots in the manifest's canonical order. The reader must
+/// rebind every declaration to this compilation, never a previous AST instance.
+/// ResolutionKey is FINAL: R_m = H(L_m, G_m), after global passes. In particular
+/// G_m must cover modular-termination classifications read during translation.
+/// Computing/validating G_m is a caller obligation, not implemented here.
+/// </summary>
+public sealed record HistoryFreeTranslationInput(
+  string ResolutionKey,
+  string ModuleIdentity,
+  ModuleDefinition Module,
+  IReadOnlyList<ModuleDefinition> Modules,
+  IReadOnlyList<int> Bitwidths,
+  IReadOnlyList<TopLevelDecl> SystemDeclarations,
+  IReadOnlySet<Declaration> VerificationDeclarations);
+
+/// <summary>
+/// Dynamic scope for synchronous DoTranslation only; no await may occur inside
+/// it. All reference-keyed dictionaries are local and are never serialized.
+/// This indirection covers existing direct Declaration.IdGenerator/UniqueName
+/// reads without missing an expression translator or a nested visitor.
+/// </summary>
+internal sealed class TranslationLocalState : IDisposable {
+  [ThreadStatic] private static TranslationLocalState? current;
+  public static TranslationLocalState? Current => current;
+  private readonly Dictionary<Declaration, VerificationIdGenerator> generators = new(ReferenceEqualityComparer.Instance);
+  private readonly Dictionary<IVariable, string> names = new(ReferenceEqualityComparer.Instance);
+  private readonly Dictionary<Label, string> labels = new(ReferenceEqualityComparer.Instance);
+  private readonly Dictionary<LetExpr, Expression> lets = new(ReferenceEqualityComparer.Instance);
+  private readonly Dictionary<AssertLabel, Boogie.Expr> assertions = new(ReferenceEqualityComparer.Instance);
+  internal readonly Stack<BoogieGenerator.FuelContext> FuelContexts = new();
+
+  private TranslationLocalState() {
+    if (current != null) {
+      throw new InvalidOperationException("A translation scope must not be nested");
+    }
+    Type.ResetScopes();
+    current = this;
+  }
+
+  public static TranslationLocalState? Enter(HistoryFreeTranslationInput? input) =>
+    input == null ? null : new TranslationLocalState();
+
+  public VerificationIdGenerator Generator(Declaration declaration) {
+    if (!generators.TryGetValue(declaration, out var result)) {
+      generators.Add(declaration, result = new VerificationIdGenerator());
+    }
+    return result;
+  }
+
+  public string? NameOf(IVariable variable) => names.GetValueOrDefault(variable);
+  public string AssignName(IVariable variable, VerificationIdGenerator generator) {
+    if (!names.TryGetValue(variable, out var result)) {
+      names.Add(variable, result = generator.FreshId(variable.Name + "#"));
+    }
+    return result;
+  }
+
+  public string AssignLabel(Label label, FreshIdGenerator generator) {
+    if (!labels.TryGetValue(label, out var result)) {
+      labels.Add(label, result = generator.FreshNumericId("label"));
+    }
+    return result;
+  }
+
+  public Expression? GetLet(LetExpr expression) => lets.GetValueOrDefault(expression);
+  public void SetLet(LetExpr expression, Expression value) => lets[expression] = value;
+  public Boogie.Expr? GetAssertion(AssertLabel label) => assertions.GetValueOrDefault(label);
+  public void SetAssertion(AssertLabel label, Boogie.Expr value) => assertions[label] = value;
+
+  public void Dispose() {
+    if (!ReferenceEquals(current, this)) {
+      throw new InvalidOperationException("Mismatched translation scope");
+    }
+    current = null;
+    // Also runs on translation failure: no scopes or fuel stacks leak to the
+    // next job on the same large-stack worker thread.
+    Type.ResetScopes();
+  }
+}
