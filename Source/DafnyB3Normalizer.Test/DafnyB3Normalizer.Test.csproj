<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DafnyB3Protocol/DafnyB3Protocol.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="MapTheoryInputs/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DafnyNormalizerReferenceDirectory)' == ''">
    <ProjectReference Include="../DafnyCore/DafnyCore.csproj" />
  </ItemGroup>
  <!-- Build the normalizer's current source against an exact-source compiler release when available. -->
  <ItemGroup Condition="'$(DafnyNormalizerReferenceDirectory)' != ''">
    <Reference Include="$(DafnyNormalizerReferenceDirectory)/*.dll" />
    <Compile Include="../DafnyCore/Backends/B3/B3Normalizer.cs" Link="B3Normalizer.cs" />
    <Compile Include="../DafnyCore/Backends/B3/B3DefinitionVisibility.cs" Link="B3DefinitionVisibility.cs" />
    <Content Include="$(DafnyNormalizerReferenceDirectory)/DafnyPrelude.bpl" Link="DafnyPrelude.bpl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
