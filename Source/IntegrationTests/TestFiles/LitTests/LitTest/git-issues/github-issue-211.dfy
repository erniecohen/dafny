// Termination of calls dispatched across modules (https://github.com/erniecohen/dafny/issues/211,
// upstream dafny-lang/dafny#1588), milestones M1 to M4a, under the opt-in --modular-termination.
// Without the option nothing changes: fabiomadge's Tie program, which never terminates, verifies,
// and "decreases {:global} E" is an ordinary decreases clause with an attribute.  With it, a call
// dispatched to a bodyless member of an open trait must go to a smaller "decreases {:global}" bound
// (M1), and a call to known code that can reach one must not go to a larger bound (M2).  Code without a bound
// that can reach one (a constraint, a witness, a constant's initializer, a function value whose code is not
// known) may not run under a bound, and "decreases {:callback g} E" bounds a parameter's function value (M3).
// A global or callback bound may only use code that cannot reach a dispatched call (M4a).
//
// RUN: echo "tie, option off: verifies, as before" > "%t"
// RUN: %exits-with 0 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false "%S/Inputs/github-issue-211-tie.dfy" >> "%t"
// RUN: echo "clauses, option off: an ordinary decreases clause" >> "%t"
// RUN: %exits-with 0 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false "%S/Inputs/github-issue-211-clauses.dfy" >> "%t"
// RUN: echo "tie, option on, refresh false: rejected" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:false --modular-termination "%S/Inputs/github-issue-211-tie.dfy" >> "%t"
// RUN: echo "tie with constant bounds, option on, refresh false: rejected" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:false --modular-termination "%S/Inputs/github-issue-211-tie-bounds.dfy" >> "%t"
// RUN: echo "counter, option on, refresh false: verifies" >> "%t"
// RUN: %exits-with 0 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:false --modular-termination "%S/Inputs/github-issue-211-counter.dfy" >> "%t"
// RUN: echo "counter vacuity control, option on, refresh false: each assert false fails" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:false --modular-termination "%S/Inputs/github-issue-211-counter-false.dfy" >> "%t"
// RUN: echo "entry, option on, refresh false" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:false --modular-termination "%S/Inputs/github-issue-211-entry.dfy" >> "%t"
// RUN: echo "rules, option on, refresh false" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:false --modular-termination "%S/Inputs/github-issue-211-rules.dfy" >> "%t"
// RUN: echo "tie, option on, refresh true: rejected" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:true --general-traits:legacy --modular-termination "%S/Inputs/github-issue-211-tie.dfy" >> "%t"
// RUN: echo "tie with constant bounds, option on, refresh true: rejected" >> "%t"
// RUN: %exits-with 4 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:true --general-traits:legacy --modular-termination "%S/Inputs/github-issue-211-tie-bounds.dfy" >> "%t"
// RUN: echo "counter, option on, refresh true: verifies" >> "%t"
// RUN: %exits-with 0 %baredafny verify --use-basename-for-filename --show-snippets:false --standard-libraries:false --type-system-refresh:true --general-traits:legacy --modular-termination "%S/Inputs/github-issue-211-counter.dfy" >> "%t"
