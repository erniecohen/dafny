// Go emits a recursive group as one package; compare every runtime case with C#.
// NONUNIFORM: Runtime comparison between the C# and Go backends.
// RUN: %run --target cs --member-invariants --recursive-modules --verify-included-files "%S/Inputs/git-issue-466-java-source.dfy" --output "%t-cs" > "%t-cs.out"
// RUN: %run --target go --member-invariants --recursive-modules --verify-included-files "%S/Inputs/git-issue-466-java-source.dfy" --output "%t-go" > "%t-go.out"
// RUN: %diff "%t-cs.out" "%t-go.out"
// RUN: %run --target cs --member-invariants --recursive-modules --verify-included-files --optimize-erasable-datatype-wrapper:false "%S/Inputs/git-issue-466-java-source.dfy" --output "%t-cs-unerased" > "%t-cs-unerased.out"
// RUN: %run --target go --member-invariants --recursive-modules --verify-included-files --resolution-threads 3 --optimize-erasable-datatype-wrapper:false --additional-axioms "%S/Inputs/git-issue-466-java-source.dfy" --output "%t-unerased" > "%t-unerased.out"
// RUN: %diff "%t-cs-unerased.out" "%t-unerased.out"
// RUN: %build -t:lib --member-invariants --recursive-modules "%S/Inputs/git-issue-466-stage7-library.dfy" --output "%t.doo" > "%t"
// RUN: %cp -f "%t" "%t-cs-library.out"
// RUN: %run --target cs --member-invariants --recursive-modules "%S/Inputs/git-issue-466-java-client.dfy" --input "%t.doo" --output "%t-cs-library" >> "%t-cs-library.out"
// RUN: %run --target go --member-invariants --recursive-modules "%S/Inputs/git-issue-466-java-client.dfy" --input "%t.doo" --output "%t-library" >> "%t"
// RUN: %diff "%t-cs-library.out" "%t"
// RUN: %exits-with 4 %run --target go --member-invariants --recursive-modules "%S/Inputs/git-issue-466-stage7-negative.dfy" --output "%t-negative" >> "%t"
// RUN: %diff "%s.expect" "%t"
// RUN: %run --target cs --member-invariants --recursive-modules --optimize-erasable-datatype-wrapper:false "%S/Inputs/git-issue-466-go-names.dfy" --output "%t-cs-names" > "%t-cs-names.out"
// RUN: %run --target go --member-invariants --recursive-modules --optimize-erasable-datatype-wrapper:false "%S/Inputs/git-issue-466-go-names.dfy" --output "%t-go-names" > "%t-go-names.out"
// RUN: %diff "%t-cs-names.out" "%t-go-names.out"
// RUN: %cp -f "%S/Inputs/git-issue-466-go-order-z.dfy" "%t-archive-a.dfy"
// RUN: %cp -f "%S/Inputs/git-issue-466-go-order-a.dfy" "%t-archive-z.dfy"
// RUN: %build -t:lib --member-invariants --recursive-modules --verify-included-files "%t-archive-a.dfy" "%t-archive-z.dfy" --output "%t-order.doo" > "%t-link-ignored.out"
// RUN: %translate go %trargs --no-verify --member-invariants --recursive-modules --include-runtime "%S/Inputs/git-issue-466-go-order-library.dfy" --output "%t-link/producer" >> "%t-link-ignored.out"
// RUN: %translate go %trargs --no-verify --member-invariants --recursive-modules --include-runtime --library "%t-order.doo" "%S/Inputs/git-issue-466-go-order-client.dfy" --output "%t-link/consumer" > "%t-link-go.out"
// RUN: env GO111MODULE=auto GOPATH=%t-link/producer-go%{pathsep}%t-link/consumer-go go run "%t-link/consumer-go/src/consumer.go" >> "%t-link-go.out"
// RUN: %run --no-verify --target cs --member-invariants --recursive-modules "%S/Inputs/git-issue-466-go-order-client.dfy" --input "%t-order.doo" --output "%t-link/cs" > "%t-link-cs.out"
// RUN: %diff "%t-link-cs.out" "%t-link-go.out"
