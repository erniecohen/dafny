// RUN: %run --target py --member-invariants --recursive-modules --verify-included-files --resolution-threads 3 --optimize-erasable-datatype-wrapper:false --additional-axioms "%S/Inputs/git-issue-466-java-source.dfy" --output "%t-unerased" > "%t-unerased.out"
