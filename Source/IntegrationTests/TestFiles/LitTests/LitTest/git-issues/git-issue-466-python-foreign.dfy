// Whole-module foreign linkage, runtime comparison, archive and package interfaces.
// NONUNIFORM: Runtime comparison between C# and Python foreign implementations.
// RUN: %exits-with -any %rm -rf "%t-runtime/source/main-py"
// RUN: %exits-with -any %rm -rf "%t-runtime/archive/main-py"
// RUN: %exits-with -any %rm -rf "%t-runtime/cs"
// RUN: %run --no-verify --target py --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-main.dfy" --input "%S/Inputs/git-issue-466-python-foreign/foreign-module.py" --input "%S/Inputs/git-issue-466-python-foreign/Types.py" --input "%S/Inputs/git-issue-466-python-foreign/Members.py" --input "%S/Inputs/git-issue-466-python-foreign/Omitted.py" --input "%S/Inputs/git-issue-466-python-foreign/OmittedTypes.py" --input "%S/Inputs/git-issue-466-python-foreign/OmittedMembers.py" --input "%S/Inputs/git-issue-466-python-foreign/OnlyForeignModule.py" --input "%S/Inputs/git-issue-466-python-foreign/OnlyTypes.py" --output "%t-runtime/source/main" > "%t-py.out"
// RUN: %diff "%s.expect" "%t-py.out"
// RUN: %run --no-verify --target cs --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-main.dfy" --input "%S/Inputs/git-issue-466-python-foreign.cs" --output "%t-runtime/cs/main" > "%t-cs.out"
// RUN: %diff "%t-cs.out" "%t-py.out"
// RUN: %build --no-verify -t:lib --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-source.dfy" --output "%t.doo" > "%t-ignored"
// RUN: %run --no-verify --target py --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-client.dfy" --input "%t.doo" --input "%S/Inputs/git-issue-466-python-foreign/foreign-module.py" --input "%S/Inputs/git-issue-466-python-foreign/Types.py" --input "%S/Inputs/git-issue-466-python-foreign/Members.py" --input "%S/Inputs/git-issue-466-python-foreign/Omitted.py" --input "%S/Inputs/git-issue-466-python-foreign/OmittedTypes.py" --input "%S/Inputs/git-issue-466-python-foreign/OmittedMembers.py" --input "%S/Inputs/git-issue-466-python-foreign/OnlyForeignModule.py" --input "%S/Inputs/git-issue-466-python-foreign/OnlyTypes.py" --output "%t-runtime/archive/main" > "%t-archive.out"
// RUN: %diff "%s.expect" "%t-archive.out"
// RUN: %translate py %trargs --no-verify --member-invariants --recursive-modules --include-runtime --python-module-name ForeignPackage "%S/Inputs/git-issue-466-python-foreign-source.dfy" --output "%t-link/ForeignPackage" > "%t-ignored"
// RUN: %exits-with -any %rm -rf "%t-link/ForeignPackage"
// RUN: %mv "%t-link/ForeignPackage-py" "%t-link/ForeignPackage"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/foreign-module.py" "%t-link/ForeignPackage/ForeignModule.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/Types.py" "%t-link/ForeignPackage/Types.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/Members.py" "%t-link/ForeignPackage/Members.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/Omitted.py" "%t-link/ForeignPackage/Omitted.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/OmittedTypes.py" "%t-link/ForeignPackage/OmittedTypes.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/OmittedMembers.py" "%t-link/ForeignPackage/OmittedMembers.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/OnlyForeignModule.py" "%t-link/ForeignPackage/OnlyForeignModule.py"
// RUN: %cp -f "%S/Inputs/git-issue-466-python-foreign/OnlyTypes.py" "%t-link/ForeignPackage/OnlyTypes.py"
// RUN: %translate py %trargs --no-verify --member-invariants --recursive-modules --include-runtime --library "%t.doo" --translation-record "%t-link/ForeignPackage/ForeignPackage-py.dtr" "%S/Inputs/git-issue-466-python-foreign-client.dfy" --output "%t-link/client" > "%t-linked.out"
// RUN: env PYTHONPATH=%t-link python3 "%t-link/client-py" >> "%t-linked.out"
// RUN: %diff "%s.expect" "%t-linked.out"
// A dotted foreign name must not turn the generated group's filename into a package path.
// RUN: %run --no-verify --target py --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-dotted.dfy" --input "%S/Inputs/git-issue-466-python-foreign-dotted.py" --output "%t-dotted/py" > "%t-dotted-py.out"
// RUN: %OutputCheck --file-to-check "%t-dotted-py.out" "%S/Inputs/git-issue-466-python-foreign-dotted.check"
// RUN: %run --no-verify --target cs --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-dotted.dfy" --output "%t-dotted/cs" > "%t-dotted-cs.out"
// RUN: %diff "%t-dotted-cs.out" "%t-dotted-py.out"
// RUN: %exits-with 1 %translate py %trargs --no-verify --member-invariants --recursive-modules --python-module-name ForeignPackage "%S/Inputs/git-issue-466-python-foreign-dotted.dfy" --output "%t-dotted/package" &> "%t-dotted-package.out"
// RUN: %OutputCheck --file-to-check "%t-dotted-package.out" "%S/Inputs/git-issue-466-python-foreign-dotted-package.check"
// Foreign types may inherit lower generated traits without importing higher foreign siblings there.
// RUN: %run --no-verify --target py --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-lower.dfy" --input "%S/Inputs/git-issue-466-python-foreign-lower.py" --input "%S/Inputs/git-issue-466-python-foreign-lower-second.py" --output "%t-lower/py" > "%t-lower-py.out"
// RUN: %OutputCheck --file-to-check "%t-lower-py.out" "%S/Inputs/git-issue-466-python-foreign-lower.check"
// RUN: %run --no-verify --target cs --member-invariants --recursive-modules "%S/Inputs/git-issue-466-python-foreign-lower.dfy" --output "%t-lower/cs" > "%t-lower-cs.out"
// RUN: %diff "%t-lower-cs.out" "%t-lower-py.out"
