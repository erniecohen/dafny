module Extends {
  method M(s: Square, r: raw Square)
      returns (a: Shape, b: Shape, n: int)
    decreases s, r
  {
    a := s;
    b := r;
    n := s.Area() + a.Area();
    var v: bool := r.Valid() && a.Valid();
  }

  trait Shape {
    function Area(): int

    predicate Valid()
  }

  datatype Square extends Shape = Square(side: int) {
    invariant /* invariant#0 */ Valid()

    function Area(): int
    {
      side * side
    }

    // raw member: 'this' has type 'raw Square'
    predicate Valid()
    {
      side >= 0
    }
  }
  /*-- type with member invariants
  type Square = v: raw Square
    | v.invariant#0()
    witness *
  */
}

module Diamond {
  method M(b: Both, r: raw Both)
      returns (t: Top, l: Left, rt: Right, s: seq<raw Both>)
    decreases b, r
  {
    t, l, rt := b, b, r;
    s := [r, b];
    var i: int := r.Id() + t.Id() + l.Id();
    var q: bool := b.Sym();
  }

  trait Top {
    function Id(): int
  }

  trait Left extends Top { }

  trait Right extends Top { }

  datatype Both extends Left, Right = Both(x: int, y: int) {
    invariant /* invariant#0 */ Id() == x

    // raw member: 'this' has type 'raw Both'
    function Id(): int
    {
      x
    }

    predicate Sym()
      decreases this
    {
      x == y
    }
  }
  /*-- type with member invariants
  type Both = v: raw Both
    | v.invariant#0()
    witness *
  */
}

module GenericExtends {
  method M<T>(b: Bounded<T>, r: raw Bounded<T>)
      returns (c: Container<T>, d: Container<T>)
    decreases b, r
  {
    c := b;
    d := r;
  }

  trait Container<T> {
    function Elems(): seq<T>
  }

  datatype Bounded<T> extends Container<T> = Bounded(s: seq<T>, cap: nat) {
    invariant /* invariant#0 */ |Elems()| <= cap

    // raw member: 'this' has type 'raw Bounded'
    function Elems(): seq<T>
    {
      s
    }
  }
  /*-- type with member invariants
  type Bounded<T> = v: raw Bounded<T>
    | v.invariant#0()
    witness *
  */
}

module Mutual {
  method M(t: Tree, f: Forest)
      returns (r: raw Forest, u: raw Tree)
    decreases t, f
  {
    r := Cons(t, f);
    u := Node(0, r);
  }

  datatype Tree = Leaf(key: int) | Node(key: int, kids: Forest) {
    invariant /* invariant#0 */ Node? ==> kids.Above(key)
    invariant /* invariant#1 */ Forest.Nil.Count() == 0

    function Size(): nat
      decreases this
    {
      if Leaf? then
        1
      else
        1 + kids.Size()
    }
  }
  /*-- type with member invariants
  type Tree = v: raw Tree
    | v.invariant#0() && v.invariant#1()
    witness *
  */

  datatype Forest = Nil | Cons(head: Tree, tail: Forest) {
    invariant /* invariant#0 */ Cons? ==> tail.Count() < 100

    predicate Above(n: int)
      decreases this, n
    {
      Cons? ==>
        head.key > n &&
        tail.Above(n)
    }

    function Count(): nat
      decreases this
    {
      if Nil? then
        0
      else
        1 + tail.Count()
    }

    function Size(): nat
      decreases this
    {
      if Nil? then
        0
      else
        head.Size() + tail.Size()
    }
  }
  /*-- type with member invariants
  type Forest = v: raw Forest
    | v.invariant#0()
    witness *
  */
}

