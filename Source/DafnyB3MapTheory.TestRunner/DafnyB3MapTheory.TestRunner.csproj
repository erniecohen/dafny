<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DafnyB3Protocol/DafnyB3Protocol.csproj" />
    <Content Include="../DafnyB3Normalizer.Test/MapTheoryInputs/**/*" Link="MapTheoryInputs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DafnyNormalizerReferenceDirectory)' == ''">
    <ProjectReference Include="../DafnyCore/DafnyCore.csproj" />
  </ItemGroup>
  <!-- Match the structural normalizer tests' exact-compiler linked-source build option. -->
  <ItemGroup Condition="'$(DafnyNormalizerReferenceDirectory)' != ''">
    <Reference Include="$(DafnyNormalizerReferenceDirectory)/*.dll" />
    <Compile Include="../DafnyCore/Backends/B3/B3Normalizer.cs" Link="B3Normalizer.cs" />
    <Compile Include="../DafnyCore/Backends/B3/B3DefinitionVisibility.cs" Link="B3DefinitionVisibility.cs" />
    <Compile Include="../DafnyCore/Backends/B3/B3StructuredCfgCorrespondence.cs" Link="B3StructuredCfgCorrespondence.cs" />
    <Compile Include="../DafnyCore/Backends/B3/B3DefinitionMustVisibility.cs" Link="B3DefinitionMustVisibility.cs" />
    <Compile Include="../DafnyCore/Backends/B3/B3DefinitionContexts.cs" Link="B3DefinitionContexts.cs" />
    <Compile Include="../DafnyCore/Backends/B3/B3ContextCoordinator.cs" Link="B3ContextCoordinator.cs" />
  </ItemGroup>
</Project>
