(set-logic ALL)
(set-option :print-success false)
(set-option :timeout 20000)
(set-option :rlimit 200000)
(set-option :smt.arith.solver 2)
(declare-const x (_ BitVec 3))
(declare-const a (_ BitVec 3))
(declare-const b (_ BitVec 3))
(define-fun portable_left ((v (_ BitVec 3)) (n (_ BitVec 3))) (_ BitVec 3)
  (let ((k (bvurem n #b011)))
    (bvor (bvshl v k) (bvlshr v (bvsub #b011 k)))))
(define-fun portable_right ((v (_ BitVec 3)) (n (_ BitVec 3))) (_ BitVec 3)
  (let ((k (bvurem n #b011)))
    (bvor (bvlshr v k) (bvshl v (bvsub #b011 k)))))
(assert (= x #b001))
(assert (= a #b011))
(assert (= b #b000))
(assert (not (= (ext_rotate_left (ext_rotate_right x a) b) #b001)))
(check-sat)
(get-info :all-statistics)
(exit)

