<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation><IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost><AssemblyName>UnsignedSourceProbe</AssemblyName>
  </PropertyGroup>
  <Target Name="RequireCapturedCompiler" BeforeTargets="ResolveReferences">
    <Error Condition="'$(B3CapturedDirectory)' == ''" Text="Supply the immutable captured compiler assembly directory." />
  </Target>
  <ItemGroup>
    <Reference Include="$(B3CapturedDirectory)/*.dll" />
    <Content Include="$(B3CapturedDirectory)/DafnyPrelude.bpl" Link="DafnyPrelude.bpl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
