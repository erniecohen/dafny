<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation><IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireCapturedProtocol" BeforeTargets="ResolveReferences">
    <Error Condition="'$(B3CaptureProtocolAssembly)' == ''" Text="Supply the exact captured schema-2 protocol assembly." />
  </Target>
  <ItemGroup><Reference Include="DafnyB3Protocol"><HintPath>$(B3CaptureProtocolAssembly)</HintPath></Reference></ItemGroup>
</Project>
