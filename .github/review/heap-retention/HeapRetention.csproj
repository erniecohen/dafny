<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GcDumpVersion>10.0.750501</GcDumpVersion>
    <GcDumpDirectory>$(NuGetPackageRoot)dotnet-gcdump/$(GcDumpVersion)/tools/net8.0/any</GcDumpDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the collector's own graph reader, with a fixed serialization version. -->
    <PackageDownload Include="dotnet-gcdump" Version="[$(GcDumpVersion)]" />
    <Reference Include="dotnet-gcdump" HintPath="$(GcDumpDirectory)/dotnet-gcdump.dll" />
    <Reference Include="Microsoft.Diagnostics.FastSerialization" HintPath="$(GcDumpDirectory)/Microsoft.Diagnostics.FastSerialization.dll" />
    <None Include="$(GcDumpDirectory)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
