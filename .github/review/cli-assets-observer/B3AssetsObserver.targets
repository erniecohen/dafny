<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Evidence only. Actual import/intrinsic closure and execution pins must be reviewed first. -->
  <Import Project="$(MSBuildThisFileDirectory)B3AssetsObserver.inputs.props" />
  <PropertyGroup>
    <B3AssetsObserverEligible>false</B3AssetsObserverEligible>
    <B3AssetsObserverEligible Condition="'$(MSBuildProjectFullPath)' == '$(B3AssetsObserverOwnerProject)' And '$(TargetFramework)' == 'net8.0' And '$(Configuration)' == 'Release' And '$(Platform)' == 'AnyCPU' And '$(DesignTimeBuild)' != 'true'">true</B3AssetsObserverEligible>
  </PropertyGroup>
  <UsingTask TaskName="B3AssetsObserver.CaptureTask" AssemblyFile="$(B3AssetsObserverWorkRoot)/build/B3AssetsObserver.dll" />
  <Target Name="B3AssetsObserverPrepare" Condition="'$(B3AssetsObserverEligible)' == 'true'">
    <PropertyGroup>
      <B3AssetsObserverCscExitCode>unobserved</B3AssetsObserverCscExitCode>
      <B3AssetsObserverCscLastTaskResult>unobserved</B3AssetsObserverCscLastTaskResult>
      <B3AssetsObserverControlHash></B3AssetsObserverControlHash>
    </PropertyGroup>
    <Microsoft.CodeAnalysis.BuildTasks.Csc
      TargetType="Library" OutputAssembly="$(B3AssetsObserverWorkRoot)/build/B3AssetsObserver.dll"
      Sources="$(B3AssetsObserverWorkRoot)/source/B3AssetsObserver.cs"
      References="$(B3AssetsObserverSdkRoot)/ref/netstandard.dll;$(B3AssetsObserverSdkRoot)/ref/Microsoft.Build.Framework.dll"
      UseSharedCompilation="false" NoConfig="true" NoStandardLib="true" Deterministic="true"
      Optimize="false" EmitDebugInformation="false" LangVersion="12" Nullable="enable"
      CheckForOverflowUnderflow="true" AllowUnsafeBlocks="false" ProvideCommandLineArgs="true"
      SkipCompilerExecution="false" Utf8Output="true" WarningLevel="4" TreatWarningsAsErrors="false"
      ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CommandLineArgs" ItemName="B3AssetsObserverCompilerArguments" />
      <Output TaskParameter="ExitCode" PropertyName="B3AssetsObserverCscExitCode" />
    </Microsoft.CodeAnalysis.BuildTasks.Csc>
    <!-- Capture the intrinsic before ANY intervening task. ExitCode remains an independent sentinel/output. -->
    <PropertyGroup>
      <B3AssetsObserverCscLastTaskResult>$(MSBuildLastTaskResult)</B3AssetsObserverCscLastTaskResult>
      <B3AssetsObserverCscLastTaskResult Condition="'$(B3AssetsObserverCscLastTaskResult)' == ''">unobserved</B3AssetsObserverCscLastTaskResult>
    </PropertyGroup>
    <WriteLinesToFile File="$(B3AssetsObserverWorkRoot)/control/compiler-arguments.txt"
      Lines="@(B3AssetsObserverCompilerArguments)" Encoding="ASCII" Overwrite="false" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <B3AssetsObserverControl Include="B3AssetsObserverPreload/1" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverWorkRoot)/source/B3AssetsObserver.cs" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverHelperSourceHash)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverWorkRoot)/build/B3AssetsObserver.dll" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverSdkRoot)/ref/netstandard.dll" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverNetstandardHash)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverSdkRoot)/ref/Microsoft.Build.Framework.dll" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverBuildFrameworkHash)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverWorkRoot)/control/compiler-arguments.txt" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverCompilerOptionsHash)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverEvidenceRoot)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverSourceSeal)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverCscLastTaskResult)" />
      <B3AssetsObserverControl Include="$(B3AssetsObserverCscExitCode)" />
    </ItemGroup>
    <WriteLinesToFile File="$(B3AssetsObserverWorkRoot)/control/compiler-inputs.txt"
      Lines="@(B3AssetsObserverControl)" Encoding="ASCII" Overwrite="false" ContinueOnError="WarnAndContinue" />
    <!-- GetFileHash sees one fixed own control item, never SDK arrays. Python reopens/hashes it via descriptors. -->
    <GetFileHash Files="$(B3AssetsObserverWorkRoot)/control/compiler-inputs.txt" Algorithm="SHA256"
      HashEncoding="hex" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="Hash" PropertyName="B3AssetsObserverControlHash" />
    </GetFileHash>
    <Exec Condition="'$(B3AssetsObserverControlHash)' != ''" ContinueOnError="WarnAndContinue"
      Command="&quot;$(B3AssetsObserverPython)&quot; -I -S -B &quot;$(B3AssetsObserverWorkRoot)/source/preserve-observer.py&quot; --preserve-before-load &quot;$(B3AssetsObserverWorkRoot)/control/compiler-inputs.txt&quot; &quot;$(B3AssetsObserverControlHash)&quot;" />
  </Target>
  <Target Name="B3AssetsObserverResolvePackageAssets_before" BeforeTargets="ResolvePackageAssets" DependsOnTargets="B3AssetsObserverPrepare"
    Condition="'$(B3AssetsObserverEligible)' == 'true'">
    <B3AssetsObserver.CaptureTask
      Condition="'$(B3AssetsObserverCscExitCode)' == '0' And '$(B3AssetsObserverCscLastTaskResult)' == 'true' And Exists('$(B3AssetsObserverEvidenceRoot)/first/ready')"
      B3AssetsObserverSlot="ResolvePackageAssets.before" B3AssetsObserverRoot="$(B3AssetsObserverEvidenceRoot)"
