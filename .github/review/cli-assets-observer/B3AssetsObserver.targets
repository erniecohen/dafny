      B3AssetsObserverP57="$(ContinueOnError)"
      B3AssetsObserverP58="$(UsingNETSdkDefaults)"
      B3AssetsObserverP59="$(MSBuildAllProjects)"
      B3AssetsObserverP60="$(UseSharedCompilation)"
      B3AssetsObserverP61="$(CustomAfterMicrosoftCommonTargets)"
