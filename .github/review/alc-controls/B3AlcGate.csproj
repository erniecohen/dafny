<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>B3AlcGate.Program</StartupObject>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Update="control-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="source-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="native-solver-wrapper.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="native-proof-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="lifecycle-control-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="lifecycle-seal-probe.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="native-lifecycle-fixture.c" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LIFECYCLE-CONTROLS.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="proof-fixtures/**/*.dfy" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
