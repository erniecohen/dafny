<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DafnyBinaries Condition="'$(DafnyBinaries)' == ''">$(MSBuildThisFileDirectory)../../../Binaries/net10.0</DafnyBinaries>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(DafnyBinaries)/DafnyPrelude.bpl" Link="DafnyPrelude.bpl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="control.bpl" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="$(DafnyBinaries)/*.dll" />
  </ItemGroup>
</Project>
