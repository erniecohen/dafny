  ],
  "patches": [
    {
      "path": "src/Verifier/Incarnations.dfy",
      "change": "Replace the inconsistent pure Expect helper with checked method lookups and substitution; use structural decreases and iterative sequence traversal; expose substitution for controls."
    },
    {
      "path": "src/Ast/TypeChecker.dfy",
      "change": "Check both automatic invariants and return Fail for malformed expressions."
    },
    {
      "path": "src/Verifier/Verifier.dfy",
      "change": "Check automatic invariants and procedure headers; sequence the now-method-based type translations."
    },
    {
      "path": "src/Solver/ExternalSolvers.dfy",
      "change": "Replace the fictitious response-length premise with a decreasing line budget and Failure on exhaustion; expose bounded reading for controls and sequence native logging."
    },
    {
      "path": "src/Solver/DeclarationMarkers.dfy",
      "change": "Remove the unchecked-termination trait marker."
    },
    {
      "path": "src/Driver/CommandLineOptions.dfy",
      "change": "Check trait termination and close OptionInfo termination across the CLI override boundary."
    },
    {
      "path": "src/Driver/Main.dfy",
      "change": "Remove unchecked termination from Main and the standard-input helper."
    },
    {
      "path": "src/Util/StdinReader.dfy",
      "change": "Remove the axiom marker and unchecked termination from the contract-free native input method."
    },
    {
      "path": "src/Util/OSProcesses.dfy",
      "change": "Replace trusted native validity and freshness with a checked Dafny wrapper around contract-free native input methods."
    },
    {
      "path": "target/cs/src/OSProcess.cs",
      "change": "Rename the native class to OSProcessHandle for the checked Dafny wrapper."
    }
  ],
